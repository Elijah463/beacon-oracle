# =============================================================
# BEACON -- USDC/NGN Oracle -- Environment Variables
# Copy the lines you need into .env and fill in real values.
# NEVER commit .env to git. (.gitignore already excludes it.)
# =============================================================

# ---- Circle Platform (required for reporter + wallet setup) ----
# Standard Developer API Key from https://console.circle.com
CIRCLE_API_KEY=your-circle-api-key-here

# Registered 32-byte entity secret (see GUIDE.md section 3)
CIRCLE_ENTITY_SECRET=your-entity-secret-hex-here

# ---- Reporter wallet (set after running setup-reporter-wallet.ts) ----
# The Circle-managed EOA wallet that calls transmit() on the contract.
# Created by: bun run scripts/setup-reporter-wallet.ts
REPORTER_WALLET_ID=your-circle-wallet-id-here
REPORTER_WALLET_ADDRESS=0xYourReporterWalletAddressHere

# ---- Contract -----------------------------------------------
# Deployed USDCNGNOracle proxy address
VITE_ORACLE_CONTRACT_ADDRESS=0x5147ebbc5d7124a27325a0ea04f6b552410ec90d

# ---- RPC (auto-provisioned by Arc Studio -- do not edit) -----
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# ---- FX API keys --------------------------------------------
# ExchangeRate-API -- free tier: 1,500 req/month
# Cached for 1 hour so reporter only calls ~24 times/day
# Sign up: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key-here

# OpenExchangeRates -- optional fallback, free tier: 1,000 req/month
# Sign up: https://openexchangerates.org/
OPEN_EXCHANGE_RATES_APP_ID=your-openexchangerates-app-id-here

# ---- CEX API keys (optional) --------------------------------
# Binance, Coinbase, Kraken public spot endpoints need no auth.
# Add keys here only if you need higher rate limits.
# BINANCE_API_KEY=
# COINBASE_API_KEY=
# KRAKEN_API_KEY=

# CF_WORKER_URL: Cloudflare Worker relay URL for Nigerian P2P geo-bypass.
# Deploy cloudflare-worker/index.js to Cloudflare Workers (free, no credit card).
# Format: https://beacon-ngn-relay.YOUR_NAME.workers.dev
CF_WORKER_URL=
